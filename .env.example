# Public application origin, including https:// and no trailing slash.
APP_URL=https://replace-with-production-origin.example
RELEASE_ID=roadmap-v1.0.0

# Fail-closed incident and recovery control. Only the exact value `enabled`
# permits state-changing HTTP requests or scheduled work. Use `frozen` to
# contain writes; missing, malformed, or padded values also freeze writes.
APPLICATION_WRITE_MODE=frozen

# Public-host instructor authentication. Direct production releases use the
# exact `oidc_v1` mode with Authorization Code + PKCE. The issuer and APP_URL
# must be canonical public HTTPS URLs without explicit ports. Store the three
# secret values in the provider secret store, never in rendered config or Git.
INSTRUCTOR_AUTH_MODE=oidc_v1
OIDC_ISSUER=https://replace-with-approved-issuer.example
OIDC_CLIENT_ID=
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
OIDC_ID_TOKEN_SIGNING_ALG=RS256
AUTH_SESSION_LIFETIME_SECONDS=3600
OIDC_CLIENT_SECRET=
AUTH_SESSION_PEPPER=
# Unpadded base64url encoding of exactly 32 random bytes.
AUTH_TRANSACTION_ENCRYPTION_KEY=

# Central instructor product-access policy. Production fails closed when the
# selected mode or any required value is missing/invalid.
# owner_private uses only HMAC-SHA-256 digests of trimmed, lowercased SIWC
# emails; never place plaintext owner emails in the digest allowlist.
# subscription_required uses explicit comma-separated Stripe status and Price
# allowlists plus an explicit 900-to-31536000-second maximum age for the local
# provider projection. Scheduled recovery becomes due before that boundary.
INSTRUCTOR_ACCESS_MODE=
OWNER_PRIVATE_ACCESS_PEPPER=
OWNER_PRIVATE_EMAIL_DIGESTS=
SUBSCRIPTION_ACCESS_STATUSES=
STRIPE_RECOGNIZED_PRICE_IDS=
SUBSCRIPTION_ENTITLEMENT_PRICE_IDS=
SUBSCRIPTION_MAX_PROJECTION_AGE_SECONDS=

# Independent privacy-operator authorization. Both values are required for
# `/api/operations/data-requests`; missing, malformed, or duplicate digests
# fail closed. Digests are HMAC-SHA-256(trimmed lowercase SIWC email) using a
# separate high-entropy pepper. Never place plaintext emails in this list and
# never reuse the owner-private access pepper.
DATA_REQUEST_OPERATOR_ACCESS_PEPPER=
DATA_REQUEST_OPERATOR_EMAIL_DIGESTS=

# Stripe Billing. Configure these as hosted secrets/variables before enabling charges.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_PRICE_ID=
# Required Checkout Session lifetime. This application accepts 1860 through
# 86400 seconds, preserving latency headroom above Stripe's 1800-second floor;
# no application default is selected.
STRIPE_CHECKOUT_SESSION_LIFETIME_SECONDS=
# Owner-supplied, versioned exact Roadmap Solo offer. This is deliberately
# separate from coaching packages and has no defaults. The priceId must match
# STRIPE_CHECKOUT_PRICE_ID, and providerMode must match the Stripe secret-key
# test/live prefix. Missing, partial, or mismatched configuration keeps Checkout
# unavailable even if BILLING_CHECKOUT_ENABLED=true.
# Shape: {"version":"<version>","approvalReference":"<owner decision/evidence>","providerMode":"test|live","priceId":"price_<id>","currency":"CAD","amountMinor":<positive integer>,"billingInterval":"month|year","trialTerms":"<exact terms>","cancellationTerms":"<exact terms>","pauseResumeTerms":"<exact terms>","taxTerms":"<exact terms>","refundTerms":"<exact terms>","failedPaymentTerms":"<exact terms>","dataAfterEndTerms":"<exact terms>","supportContact":"<exact public route>"}
BILLING_COMMERCIAL_POLICY_JSON=
# Fail-closed release flag. Set true only after exact price/policy approval.
BILLING_CHECKOUT_ENABLED=false

# Independent secret pepper of at least 32 characters used to derive
# non-reversible share-token lookup hashes.
SHARE_TOKEN_PEPPER=

# Separate high-entropy secret (at least 32 characters) for privacy-minimizing
# abuse-control subject digests.
ABUSE_LIMIT_PEPPER=

# Fail-closed consent-recording registry. This must be owner-supplied,
# versioned policy content; the application provides no wording or legal-basis
# default. Omit purposes that are not approved/configured. Configuration alone
# permits recording a choice and does not enable media, marketing, research,
# analytics, or any other optional processing. Production golfer processing
# also requires configured `golfer_record`/account and
# `roadmap_sharing`/golfer entries plus matching current grants. Any
# purpose-description change requires a new version; changing text without a
# new version also fails existing grants closed.
# Shape (shown without substantive copy):
# {"<purpose>":{"version":"<approved-version>","purposeDescription":"<approved exact text>","subjectTypes":["account","golfer"]}}
CONSENT_POLICY_REGISTRY_JSON=

# Owner-supplied, versioned media limits. Exact live formats, size/duration
# limits, retention, and processing policy remain owner inputs. Missing or
# invalid configuration keeps upload unavailable; local synthetic QA may use a
# clearly test-only policy.
# `maxBytes` must be an integer from 1,024 through 50,000,000. The route-owned
# protocol enforces the configured file length while streaming into R2. The
# exact production choice within that implementation bound remains owner input.
# Shape: {"version":"<approved-version>","maxBytes":<integer>,"maxVideoDurationMs":<integer>,"allowedMimeTypes":["image/jpeg","image/png","image/webp","video/mp4","video/quicktime","video/webm","text/csv"],"accountMediaConsentRequired":<boolean>,"golferMediaConsentRequired":<boolean>}
MEDIA_UPLOAD_POLICY_JSON=

# Optional local-only identity. Production accepts only Worker-verified
# `oidc_v1`, or the explicit `.chatgpt.site` staging adapter.
DEV_AUTH_EMAIL=owner@roadmap.local
DEV_AUTH_NAME=Roadmap Owner
