# Public application origin, including https:// and no trailing slash.
APP_URL=https://replace-with-production-origin.example
RELEASE_ID=roadmap-v1.0.0

# Central instructor product-access policy. Production fails closed when the
# selected mode or any required value is missing/invalid.
# owner_private uses only HMAC-SHA-256 digests of trimmed, lowercased SIWC
# emails; never place plaintext owner emails in the digest allowlist.
# subscription_required uses explicit comma-separated Stripe status and Price
# allowlists plus a bounded maximum age for the local provider projection.
INSTRUCTOR_ACCESS_MODE=
OWNER_PRIVATE_ACCESS_PEPPER=
OWNER_PRIVATE_EMAIL_DIGESTS=
SUBSCRIPTION_ACCESS_STATUSES=
STRIPE_RECOGNIZED_PRICE_IDS=
SUBSCRIPTION_ENTITLEMENT_PRICE_IDS=
SUBSCRIPTION_MAX_PROJECTION_AGE_SECONDS=

# Stripe Billing. Configure these as hosted secrets/variables before enabling charges.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_PRICE_ID=
# Required Checkout Session lifetime. This application accepts 1860 through
# 86400 seconds, preserving latency headroom above Stripe's 1800-second floor;
# no application default is selected.
STRIPE_CHECKOUT_SESSION_LIFETIME_SECONDS=
# Fail-closed release flag. Set true only after exact price/policy approval.
BILLING_CHECKOUT_ENABLED=false

# Secret pepper used to derive non-reversible share-token lookup hashes.
SHARE_TOKEN_PEPPER=

# Separate high-entropy secret (at least 32 characters) for privacy-minimizing
# abuse-control subject digests.
ABUSE_LIMIT_PEPPER=

# Optional local-only identity. Production always uses dispatch-owned sign-in.
DEV_AUTH_EMAIL=owner@roadmap.local
DEV_AUTH_NAME=Roadmap Owner
