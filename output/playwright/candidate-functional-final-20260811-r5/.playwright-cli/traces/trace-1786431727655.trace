omplete reset and written observation between sets.\n            - emphasis [ref=f1e158]: \"Look for: The agreed strike window repeats in the coach-defined representative set.\"\n            - group [ref=f1e159]:\n              - generic \"Full drill guidance\" [ref=f1e160] [cursor=pointer]\n            - group \"Quick practice check-in\" [ref=f1e162]:\n              - generic [ref=f1e164]:\n                - generic [ref=f1e165]:\n                  - radio \"Completed\" [ref=f1e166]\n                  - text: Completed\n                - generic [ref=f1e167]:\n                  - radio \"Not completed\" [ref=f1e168]\n                  - text: Not completed\n              - generic [ref=f1e169]:\n                - generic [ref=f1e170]:\n                  - text: Difficulty (optional)\n                  - combobox \"Difficulty (optional)\" [ref=f1e171]:\n                    - option \"Choose\" [selected]\n                    - option \"Very easy\"\n                    - option \"Easy\"\n                    - option \"About right\"\n                    - option \"Hard\"\n                    - option \"Very hard\"\n                - generic [ref=f1e172]:\n                  - text: Confidence (optional)\n                  - combobox \"Confidence (optional)\" [ref=f1e173]:\n                    - option \"Choose\" [selected]\n                    - option \"1 — not confident\"\n                    - option \"2\"\n                    - option \"3\"\n                    - option \"4\"\n                    - option \"5 — very confident\"\n              - generic [ref=f1e174]:\n                - text: Short note (optional)\n                - textbox \"Short note (optional)\" [ref=f1e175]:\n                  - /placeholder: What did you notice?\n              - generic [ref=f1e176]:\n                - checkbox \"I would like help from my coach\" [ref=f1e177]\n                - text: I would like help from my coach\n              - button \"Record check-in\" [ref=f1e178] [cursor