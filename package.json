{
  "name": "roadmap-production-saas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run verify:release-artifacts && node --experimental-transform-types --test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .work",
    "typecheck": "tsc --noEmit --pretty false",
    "verify": "npm run lint && npm run typecheck && npm test",
    "audit:production": "npm audit --omit=dev",
    "db:generate": "drizzle-kit generate",
    "exercise:capacity:local": "npm run build && node scripts/local-synthetic-capacity-exercise.mjs",
    "exercise:recovery:local": "npm run build && node scripts/local-synthetic-recovery-exercise.mjs",
    "generate:supply-chain-evidence": "node scripts/generate-supply-chain-evidence.mjs",
    "verify:release-archive": "node scripts/verify-release-archive.mjs",
    "verify:release-artifacts": "node scripts/release-artifact-integrity.mjs",
    "verify:release-integrity": "node scripts/release-integrity-check.mjs",
    "verify:reproducible-builds": "node scripts/compare-release-builds.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/workers-types": "5.20260808.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "miniflare": "5.20260801.1-alpha",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.45",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
